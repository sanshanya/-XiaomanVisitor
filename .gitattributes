# Stable text files on Windows; do not normalize binary assets.
* text=auto eol=lf
*.cs text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv -text

# Editable media belong in LFS, not repeatedly in Git history.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text

# Published package text and source inputs carry approved byte hashes.
package/** -text
reference/** -text
story/酒馆设计/** -text
assets/tavern-scene/provided-layout.json -text -whitespace

# Keep published bytes, original manuscripts and upstream license formatting.
package/** -whitespace
reference/** -whitespace
story/** -whitespace
docs/history/** -whitespace
experiments/handwriting/fonts/** -whitespace
