    {
      "kind": "image",
      "value": 1,
      "seconds": 1.15,
      "act": 1,
      "transition": "door_wipe",
      "hold": 0.25
    },
    {
      "kind": "line",
      "text": "啊……真的开门了。",
      "act": 1,
      "key": "buyback_01_17"
    },
    {
      "kind": "line",
      "text": "嘿嘿，前辈还是这么温柔呢。",
      "act": 1,
      "key": "buyback_01_18"
    },
    {
